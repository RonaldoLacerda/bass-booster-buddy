# Copie para .env.local. Só nomes; nunca comite valores privados.

# Públicas (embutidas no build)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PAYMENTS_CLIENT_TOKEN=        # precisa começar com test_ ou live_

# Analytics sem cookies (opcional; desligado se vazio)
VITE_ANALYTICS_DOMAIN=             # ex.: audiomix.app
VITE_ANALYTICS_SRC=                # padrão: https://plausible.io/js/script.js

# Privadas (somente servidor / segredos da hospedagem)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
CRON_SECRET=
DATABASE_URL=                      # só para migrações (drizzle-kit)
